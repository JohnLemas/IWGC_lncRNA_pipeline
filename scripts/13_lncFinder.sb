#!/bin/bash --login
#SBATCH --job-name=lncFinder
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=12:00:00
# NOTE: --output is NOT set here: submit_3_model_predictions.sh passes it (log dir from LOG_DIR in config.sh).

set -euo pipefail

# Paths
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh
IMAGE="$RBIO_SIF"

# Inputs
OUTPUT_DIR="$LNCFINDER_DIR"
INPUT_FASTA="$CANDIDATES_FASTA"
OUTPUT_CSV="$LNCFINDER_CSV"

mkdir -p ${OUTPUT_DIR}

#lncFinder model designation: wheat, human, mouse
MODEL_TYPE="$LNCFINDER_MODEL"   # set in config.sh: wheat, human, mouse

mkdir -p $OUTPUT_DIR

echo "=========================================================="
echo "Starting LncFinder Matrix Processing"
echo "Job ID: $SLURM_JOB_ID"
echo "Allocated Cores: $SLURM_CPUS_PER_TASK"
echo "Allocated Memory: $SLURM_MEM_PER_NODE MB"
echo "Selected Model: $MODEL_TYPE"
echo "=========================================================="
date

# Run the unified R script inside the container
singularity run \
    --bind "$BIND_DIR" \
    "$IMAGE" lnc_predict \
    --fasta "$INPUT_FASTA" \
    --out "$OUTPUT_CSV" \
    --cores "$SLURM_CPUS_PER_TASK" \
    --model "$MODEL_TYPE"

EXIT_CODE=$?

echo "=========================================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "PIPELINE FINISHED SUCCESSFULLY"
else
    echo "PIPELINE FAILED WITH EXIT CODE $EXIT_CODE"
fi
echo "=========================================================="
date
