#!/bin/bash --login
#SBATCH --job-name=strg_assemble
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
# NOTE: --array and --output are NOT set here: submit_2_stringtie.sh passes them (array size from METADATA, log dir from LOG_DIR in config.sh).

# 1. Paths
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

# Extract row for current task and parse column 1 (raw ID) and column 2 (new name)
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$METADATA" | tr -d '\r')
ID=$(echo "$ROW" | awk -F'\t' '{print $2}')

# Input BAM directory
BAM_DIR="$STAR_DIR"
REF_GTF="$REF_ANN"
OUT_DIR="$ASSEMBLY_DIR"

mkdir -p $OUT_DIR

ml purge
ml load StringTie/2.2.1-GCC-11.2.0-Python-2.7.18

# 2. Run StringTie
# -G: Reference guided (finds known + novel)
# -p: Threads
# -m: Minimum transcript length (200bp is the standard cutoff for lncRNAs)
# -j: Minimum junction coverage (higher = fewer false positives)
# -o: Output GTF file
cmd="stringtie \
    ${BAM_DIR}/${ID}_Aligned.sortedByCoord.out.bam \
    -G $REF_GTF \
    -p $SLURM_CPUS_PER_TASK \
    -m 200 \
    -j 2 \
    -o ${OUT_DIR}/${ID}_assembled.gtf.partial"

echo -e "..running command:\n${cmd}\n\n"

$cmd
STATUS=$?

# The submit scripts treat a non-empty ${ID}_assembled.gtf as "done", so it only appears once
# StringTie has finished cleanly (a killed/failed task leaves at most a .partial file).
if [ $STATUS -ne 0 ] || [ ! -s "${OUT_DIR}/${ID}_assembled.gtf.partial" ]; then
    echo "ERROR: StringTie failed for $ID (exit status $STATUS) or produced no output" >&2
    rm -f "${OUT_DIR}/${ID}_assembled.gtf.partial"
    exit 1
fi
mv "${OUT_DIR}/${ID}_assembled.gtf.partial" "${OUT_DIR}/${ID}_assembled.gtf"

echo "StringTie assembly for $ID complete."