#!/bin/bash --login
#SBATCH --job-name=species_cd-hit
#SBATCH --cpus-per-task=8
#SBATCH --mem=1G
#SBATCH --time=02:00:00
# NOTE: --output is NOT set here (not part of the submit_* workflow). Run with:
#   sbatch --output="${LOG_DIR}/truth/%x-%j.out" cd-hit.sb   (after: source config.sh; mkdir -p "${LOG_DIR}/truth")

# Env setup
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

ml purge
ml load CD-HIT
ml load SeqKit

# Paths
INPUT="$TRUTH_LNCRNA_FA"   # combined fasta of all PLncDB lncRNA sequences for this species
OUTPUT="$TRUTH_CDHIT_FA"   # representative sequences after clustering at 90% identity

TOT=$(grep -c "^>" ${INPUT})
OLIM=$(seqkit seq -m 200 ${INPUT} | grep -c "^>")
ULIM=$(seqkit seq -M 200 ${INPUT} | grep -c "^>")

# command
# -c sequence identity threshold, default 0.9
# -M memory limit (in MB) for the program, default 800; 0 for unlimitted
# -T number of threads, default 1; with 0, all CPUs will be used
# -l length of throw_away_sequences, default 10
cmd="cd-hit -i ${INPUT} -o ${OUTPUT} -c 0.9 -M 800 -T 8 -l 200"

echo -e "run command:\n\t${cmd}\n"

$cmd

FIN=$(grep -c "^>" ${OUTPUT})

echo "=========================================="
echo -e "Full truth dataset: ${TOT}"
echo -e "Truth seqs greater than 200 bp: ${OLIM}"
echo -e "Truth seqs less than 200 bp: ${ULIM}"
echo -e "Final truth dataset: ${FIN}"
echo "=========================================="

echo "done"
