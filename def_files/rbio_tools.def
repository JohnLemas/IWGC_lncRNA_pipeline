Bootstrap: docker
From: ubuntu:22.04

%files
    /Users/jmlemas/Documents/BASF/build_images/intersect_ids.R /usr/local/bin/intersect_ids.R
    /Users/jmlemas/Documents/BASF/build_images/lncFinder.R /usr/local/bin/lncFinder.R
    /Users/jmlemas/Documents/BASF/build_images/intersect_lncRNA_TE.R /usr/local/bin/intersect_lncRNA_TE.R
    /Users/jmlemas/Documents/BASF/build_images/build_final_annotation.R /usr/local/bin/build_final_annotation.R
    /Users/jmlemas/Documents/BASF/build_images/parse_gffcompare_tracking.R /usr/local/bin/parse_gffcompare_tracking.R
    /Users/jmlemas/Documents/BASF/build_images/parse_tpm_matrix.R /usr/local/bin/parse_tpm_matrix.R

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/usr/local/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. System packages, build tools, and R dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        build-essential \
        gfortran \
        libgomp1 \
        pkg-config \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libdeflate-dev \
        r-base \
        r-cran-tidyverse \
        r-cran-optparse \
        r-cran-readr \
        r-cran-dplyr \
        r-cran-seqinr \
        r-cran-e1071 \
        r-cran-caret \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # 2. Compile ViennaRNA from source so 'RNAfold' is available in $PATH for LncFinder
    cd /tmp
    wget https://www.tbi.univie.ac.at/RNA/download/sourcecode/2_7_x/ViennaRNA-2.7.2.tar.gz
    tar -zxvf ViennaRNA-2.7.2.tar.gz
    cd ViennaRNA-2.7.2
    ./configure --without-perl --without-python --without-python3 --disable-all-bind
    make -j$(nproc)
    make install
    cd /tmp
    rm -rf ViennaRNA-2.7.2*

    # 3. Install LncFinder directly from CRAN
    Rscript -e "install.packages('LncFinder', repos='https://cloud.r-project.org')"

    # 3b. Install Bioconductor packages needed by intersect_lncRNA_TE.R
    Rscript -e "install.packages('BiocManager', repos='https://cloud.r-project.org')"
    Rscript -e "BiocManager::install(c('rtracklayer', 'GenomicRanges'), update = FALSE, ask = FALSE)"

    # Verify the Bioconductor packages actually installed; fail the build loudly if not
    Rscript -e "library(rtracklayer); library(GenomicRanges)" || { echo "ERROR: rtracklayer/GenomicRanges failed to install"; exit 1; }

    # 4. FIX PERMISSIONS: Ensure all baked-in scripts are world-readable and executable
    chmod -R 755 /usr/local/bin/

%runscript
    if [ "$1" = "intersect" ]; then
        shift
        exec Rscript /usr/local/bin/intersect_ids.R "$@"
    elif [ "$1" = "lnc_predict" ]; then
        shift
        exec Rscript /usr/local/bin/lncFinder.R "$@"
    elif [ "$1" = "intersect_te" ]; then
        shift
        exec Rscript /usr/local/bin/intersect_lncRNA_TE.R "$@"
    elif [ "$1" = "finalize" ]; then
        shift
        exec Rscript /usr/local/bin/build_final_annotation.R "$@"
    elif [ "$1" = "track" ]; then
        shift
        exec Rscript /usr/local/bin/parse_gffcompare_tracking.R "$@"
    elif [ "$1" = "tpm" ]; then
        shift
        exec Rscript /usr/local/bin/parse_tpm_matrix.R "$@"
    else
        echo "Usage: singularity run rbio_tools.sif [intersect|lnc_predict|intersect_te|finalize|track|tpm] [options]"
    fi

%labels
    Author "lemasjoh, Claude Sonnet 5"
    Description "Single unified image containing R, ViennaRNA, and lncRNA processing scripts (classify and add_tissue steps folded into finalize)."
