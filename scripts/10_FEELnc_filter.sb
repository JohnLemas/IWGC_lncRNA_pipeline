#!/bin/bash --login
#SBATCH --job-name=feelnc_filter
#SBATCH --cpus-per-task=20
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/path/to/working/dir/species/logs/%x_%j.out

set -euo pipefail

# 1. Paths
BASE="/path/to/working/dir" # change this to reflect your working directory
SPEC="species"
IMAGE="${BASE}/images/FEELnc2.sif"

# Inputs
INPUT_GTF="${BASE}/${SPEC}/03_outputs/04_stringtie/${SPEC}_candidates.gtf"
REF_ANN="${BASE}/${SPEC}/01_inputs/${SPEC}_mRNA.gtf"
OUTPUT_DIR="${BASE}/${SPEC}/03_outputs/05_FEELnc"
OUTPUT_GTF="${BASE}/${SPEC}/03_outputs/05_FEELnc/${SPEC}_FEELnc.gtf"
FEELNC_DIR="${BASE}/scripts/feelnc"

mkdir -p $OUTPUT_DIR

# 2. Run the script with the image
singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    env PERL5LIB="${FEELNC_DIR}/lib" \
    perl ${FEELNC_DIR}/scripts/FEELnc_filter.pl \
    -i $INPUT_GTF \
    -a $REF_ANN \
    --monoex=-1 -s 200 -p 20 > $OUTPUT_GTF

echo "FEELnc filtering complete."