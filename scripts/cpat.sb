#!/bin/bash --login
#SBATCH --job-name=soy_cpat_lnc
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x-%j.out

# Paths
echo -e ">>>CPAT-plant:\n..loading image and data.."
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/cpat_plant.sif"
SEQS="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/04_gffread/soy_candidates.fasta"
HEX="/mnt/scratch/lemasjoh/BASF/scripts/Plant-LncRNA-pipeline-v2/Model/Plant_Hexamer.tsv"
LOGIT="/mnt/scratch/lemasjoh/BASF/scripts/Plant-LncRNA-pipeline-v2/Model/Plant.logit.RData"
OUT_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/06_cpat"
OUT_ALL="${OUT_DIR}/soy_cpat.output"

echo -e "..creating output directory:\n\t${OUT_DIR}"
mkdir -p $OUT_DIR

echo -e ">>>CPAT-plant:\n.raw input data:\n\t${SEQS}\nnumber of sequences\n\t$(grep -c ">" ${SEQS})\n"

# run CPAT-plant
echo -e ">>>CPAT-plant:\n..running command on raw input data.." 
singularity exec $IMAGE cpat.py -x $HEX -d $LOGIT -g $SEQS -o $OUT_ALL

echo -e ">>>CPAT-plant:\n..complete. Output saved to:\n\t${OUT_ALL}\n"