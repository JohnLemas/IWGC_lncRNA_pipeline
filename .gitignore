# 1. Global file extensions to ignore everywhere
*fa
*gtf
*gff3
*gff
*gz
*sif
.DS_Store
*gene_info.txt
.Rhistory

# 2. Prevent Git from ignoring the top-level species directories
!/g.max/
!/z.mays/

# 3. Explicitly ignore scripts and truth data
/truth_data/
/g.max/02_scripts/
/z.mays/02_scripts/

# 4. The Trick: Allow Git into the outputs folder, but ignore its general contents
!/g.max/03_outputs/
/g.max/03_outputs/*
!/z.mays/03_outputs/
/z.mays/03_outputs/*

# 5. Whitelist the specific subdirectories you want to keep
!/g.max/03_outputs/10_intersect/
!/z.mays/03_outputs/10_intersect/
!/g.max/03_outputs/11_classify/
!/z.mays/03_outputs/11_classify/
!/g.max/03_outputs/12_verify/
!/z.mays/03_outputs/12_verify/

# 6. Allow everything inside 01_inputs (since it wasn't blocked by a parent)
!/g.max/01_inputs/
!/z.mays/01_inputs/