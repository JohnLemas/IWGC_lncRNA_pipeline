#!/bin/bash --login
#SBATCH --job-name=[species]_lncFinder
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=1:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x_%j.out

# Paths
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/lncfinder.sif" # dedicated image
RSCRIPT="/mnt/scratch/lemasjoh/BASF/[species]/02_scripts/[species]_lncFinder.R" # path to r script. edit R script to set input/output paths and parameters as needed before running this file.

# Run the R script inside the container
singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    Rscript $RSCRIPT