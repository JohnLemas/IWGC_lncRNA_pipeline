#!/bin/bash --login
#SBATCH --job-name=QC
#SBATCH --cpus-per-task=16
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --array=0-2 # runs QC on raw, trimmed, and clean reads in parallel
#SBATCH --output=/path/to/project/dir/species/logs/%x-%A_%a.SLURMout

# One array task per stage (0=raw, 1=trimmed, 2=clean) so they run in parallel
# and a timeout in one stage can't stop the others from reaching MultiQC.
# FastQC is skipped for files that already have output, so re-submitting
# resumes where a previous run stopped.

ml purge
ml load FastQC/0.12.1-Java-11
ml load MultiQC

BASE="/path/to/project/dir" # change this to reflect your working directory
SPEC="species"
THREADS="${SLURM_CPUS_PER_TASK:-8}"

case "${SLURM_ARRAY_TASK_ID}" in
  0) STAGE="raw"
     IN="${BASE}/${SPEC}/01_inputs/raw_fastq"
     OUT="${IN}/QC"
     NAME="raw_report" ;;
  1) STAGE="trimmed"
     IN="${BASE}/${SPEC}/03_outputs/01_fastp"
     OUT="${IN}/QC"
     NAME="trimmed_report" ;;
  2) STAGE="clean"
     IN="${BASE}/${SPEC}/03_outputs/02_sortmerna/clean_reads"
     OUT="${BASE}/${SPEC}/03_outputs/02_sortmerna/QC"
     NAME="clean_reads" ;;
  *) echo "Unexpected array index: ${SLURM_ARRAY_TASK_ID}" >&2; exit 1 ;;
esac

mkdir -p "${OUT}"

# Build the list of files that still need FastQC
ALL=("${IN}"/*.gz)
TODO=()
for f in "${ALL[@]}"; do
  b=$(basename "${f}")
  b=${b%.gz}; b=${b%.fastq}; b=${b%.fq}
  [[ -s "${OUT}/${b}_fastqc.zip" ]] || TODO+=("${f}")
done

echo ">>> [${STAGE}] ${#ALL[@]} files total, ${#TODO[@]} still need FastQC"

if (( ${#TODO[@]} > 0 )); then
  fastqc -t "${THREADS}" -o "${OUT}" "${TODO[@]}" \
    || { echo ">>> [${STAGE}] FastQC failed; skipping MultiQC" >&2; exit 1; }
fi

multiqc "${OUT}" -n "${NAME}" -o "${OUT}" --no-data-dir --force \
  || { echo ">>> [${STAGE}] MultiQC failed" >&2; exit 1; }

echo ">>> [${STAGE}] done: ${OUT}/${NAME}.html"
