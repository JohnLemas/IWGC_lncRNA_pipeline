#!/bin/bash --login
#SBATCH --job-name=intersect
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=00:30:00
# NOTE: --output is NOT set here: submit_4_final_outputs.sh passes it (log dir from LOG_DIR in config.sh).

# Fix the locale warnings and suppress the systemd/timedatectl warning from R packages
export LC_ALL=C
export LANG=C
export TZ="UTC"
date

set -eo pipefail

source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

# R parsing image for output files
IMAGE="$RBIO_SIF"

# Directory for the intersection outputs (IDs + per-tool summary)
mkdir -p "$INT_CLASS_DIR"

# =======>------- Intersect IDs -------<======== #
# Keeps transcripts that pass FEELnc, CPAT, LncFinder and lncBoost and have no DIAMOND protein hit.
# Writes: ${INT_PFX}_final_ids.txt and ${INT_PFX}_intersection_summary.csv
# Sequences, GTFs, classification and the annotation tables are produced by 17_finalize.sb.

# Input files. script can run with at least two of the tools, and works with gtf and txt files.
FEELnc="$FEELNC_GTF"
CPAT="$CPAT_OUT"
lncBoost="$LNCBOOST_PREDS"
lncFinder="$LNCFINDER_CSV"
DIAMOND="$DIAMOND_OUT"

echo -e ">>>Intersect:\nInput files:\n${FEELnc}\n${CPAT}\n${lncFinder}\n${lncBoost}\n${DIAMOND}\n...\n"

# Pass the flags directly to the image
cmd1="singularity run $IMAGE intersect -f $FEELnc -c $CPAT -l $lncFinder -b $lncBoost -d $DIAMOND -o $INT_PFX" # save run command in log file

echo -e ">>> Running intersect script...\n${cmd1}\n"
$cmd1

[ -s "$FINAL_IDS" ] || { echo "ERROR: no transcripts passed all filters (${FINAL_IDS} is missing or empty)" >&2; exit 1; }

echo -e ">>>Intersect:\nIntersection complete.\nlncRNA IDs ($(wc -l < "$FINAL_IDS") transcripts):\n${FINAL_IDS}\nTool summary:\n${INT_PFX}_intersection_summary.csv\n"

date
