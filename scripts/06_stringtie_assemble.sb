#!/bin/bash --login
#SBATCH --job-name=strg_assemble
#SBATCH --array=1-[number of samples from wc -l species_metadata.txt]
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/path/to/working/dir/species/logs/stringtie/%x_%a.out

# 1. Paths
BASE="/path/to/working/dir" # change this to reflect your working directory
SPEC="species"

# Extract row for current task and parse column 1 (raw ID) and column 2 (new name)
METADATA="${BASE}/${SPEC}/01_inputs/${SPEC}_metadata.txt"
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$METADATA" | tr -d '\r')
ID=$(echo "$ROW" | awk -F'\t' '{print $2}')

# Input BAM directory
BAM_DIR="${BASE}/${SPEC}/03_outputs/03_STAR"
REF_GTF="${BASE}/${SPEC}/01_inputs/${SPEC}_mRNA.gtf"
OUT_DIR="${BASE}/${SPEC}/03_outputs/04_stringtie/SRR_assemblies"

mkdir -p $OUT_DIR

ml purge
ml load StringTie/2.2.1-GCC-11.2.0-Python-2.7.18

# 2. Run StringTie
# -G: Reference guided (finds known + novel)
# -p: Threads
# -m: Minimum transcript length (200bp is the standard cutoff for lncRNAs)
# -j: Minimum junction coverage (higher = fewer false positives)
# -o: Output GTF file
cmd="stringtie \
    ${BAM_DIR}/${ID}_Aligned.sortedByCoord.out.bam \
    -G $REF_GTF \
    -p $SLURM_CPUS_PER_TASK \
    -m 200 \
    -j 2 \
    -o ${OUT_DIR}/${ID}_assembled.gtf"

echo -e "..running command:\n${cmd}\n\n"

$cmd

echo "StringTie assembly for $ID complete."