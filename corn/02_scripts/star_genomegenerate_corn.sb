#!/bin/bash --login
#SBATCH --job-name=corn_star_idx
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=45G
#SBATCH --time=01:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x-%j.SLURMout

# Paths
GENOME="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.dna.toplevel.fa"
ANNO="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.62.gff3"
INDEX="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zmays_indexed" # Cleaned path
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/plant_lnc.sif"

mkdir -p $INDEX

ml purge

# Run STAR inside the container
singularity exec -B /mnt/scratch:/mnt/scratch $IMAGE STAR \
     --runMode genomeGenerate \
     --runThreadN $SLURM_CPUS_PER_TASK \
     --genomeDir $INDEX \
     --genomeFastaFiles $GENOME \
     --sjdbGTFfile $ANNO \
     --sjdbGTFtagExonParentTranscript Parent \
     --outTmpDir /mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/_STARtmp \
     --sjdbOverhang 99