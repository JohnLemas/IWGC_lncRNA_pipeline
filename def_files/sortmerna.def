Bootstrap: docker
From: ubuntu:24.04

# Build with, e.g.:
#   singularity build sortmerna.sif sortmerna.def
# Override the version at build time with:
#   singularity build --build-arg SORTMERNA_VERSION=7.0.0 sortmerna.sif sortmerna.def

%arguments
    SORTMERNA_VERSION=7.0.0

%labels
    Author John Lemas, Claude
    Software sortmerna+barrnap
    SortMeRNA_Version {{ SORTMERNA_VERSION }}
    Source https://github.com/sortmerna/sortmerna/releases

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        barrnap
    rm -rf /var/lib/apt/lists/*

    SORTMERNA_VERSION="{{ SORTMERNA_VERSION }}"
    INSTALL_DIR=/opt/sortmerna

    mkdir -p "${INSTALL_DIR}"
    cd /tmp

    # Official self-extracting binary installer (bundles its own shared libs,
    # no compiler/conda needed). Requires glibc >= 2.38, hence Ubuntu 24.04 base.
    wget -q "https://github.com/sortmerna/sortmerna/releases/download/v${SORTMERNA_VERSION}/sortmerna-${SORTMERNA_VERSION}-Linux.sh" \
        -O sortmerna-installer.sh

    bash sortmerna-installer.sh --skip-license --prefix="${INSTALL_DIR}" --exclude-subdir

    chmod -R a+rX "${INSTALL_DIR}"
    rm -f /tmp/sortmerna-installer.sh

%environment
    export SORTMERNA_HOME=/opt/sortmerna
    export PATH="/opt/sortmerna/bin:${PATH}"

%runscript
    exec sortmerna "$@"

%test
    . /.singularity.d/env/90-environment.sh 2>/dev/null || true
    export PATH="/opt/sortmerna/bin:${PATH}"
    sortmerna --version
    barrnap --version

%help
    One-stop ribosomal filtering container: SortMeRNA (official precompiled
    binary release) + barrnap, for building custom rRNA reference databases
    from new species and then filtering reads against them.

    SortMeRNA usage:
        singularity exec sortmerna.sif sortmerna --ref db.fasta --reads reads.fastq --workdir /path/to/workdir

    barrnap usage (predict rRNA genes from a genome, extract to FASTA):
        singularity exec sortmerna.sif barrnap --kingdom bac --outseq rrna.fasta genome.fasta > rrna.gff
        --kingdom options: bac, arc, euk, mito

    Typical custom-DB workflow:
        1. barrnap --kingdom <bac|arc|euk> --outseq species_rrna.fasta genome.fasta > species_rrna.gff
        2. cat species1_rrna.fasta species2_rrna.fasta ... > custom_db.fasta
        3. (optional) dereplicate/cluster custom_db.fasta with vsearch or cd-hit-est
        4. sortmerna --ref existing_db.fasta --ref custom_db.fasta --reads reads.fastq --workdir /path/to/workdir

    No reference databases are bundled in this image — bind-mount your
    databases and genomes at runtime, e.g.:
        singularity exec -B /path/to/data:/data sortmerna.sif barrnap ...