#!/bin/bash --login
#SBATCH --job-name=corn_STAR_align
#SBATCH --array=1-165
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=07:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/corn_align_%x-%j_%A_%a.out

# 1. Paths
LIST="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/sra_accessions/z.mays_sra_IDs.txt"
ID=$(sed -n "${SLURM_ARRAY_TASK_ID}p" $LIST)
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/plant_lnc.sif"
DATA_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/01_fastp"
INDEX_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zmays_indexed"
OUT_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/02_STAR"

mkdir -p $OUT_DIR

# 2. Filename Logic
# Check for paired-end first
if [ -f "${DATA_DIR}/${ID}_1_trim.fastq.gz" ]; then
    echo "Sample $ID: PAIRED-END detected"
    READS="${DATA_DIR}/${ID}_1_trim.fastq.gz ${DATA_DIR}/${ID}_2_trim.fastq.gz"
# Otherwise check for single-end
elif [ -f "${DATA_DIR}/${ID}_trim.fastq.gz" ]; then
    echo "Sample $ID: SINGLE-END detected"
    READS="${DATA_DIR}/${ID}_trim.fastq.gz"
else
    echo "ERROR: No files found for $ID in $DATA_DIR"
    exit 1
fi

# 3. Run STAR
singularity exec $IMAGE STAR \
    --runThreadN $SLURM_CPUS_PER_TASK \
    --genomeDir $INDEX_DIR \
    --readFilesIn $READS \
    --readFilesCommand zcat \
    --outFileNamePrefix ${OUT_DIR}/${ID}_ \
    --outSAMtype BAM SortedByCoordinate \
    --outSAMattrIHstart 0 \
    --outSAMattributes NH HI AS nM NM \
    --outSAMstrandField intronMotif

echo "Alignment for $ID complete."