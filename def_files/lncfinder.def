Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer your_name
    Version v1.0
    Description Image for LncFinder with Secondary Structure (ViennaRNA) support

%environment
    # Set locale to avoid R encoding issues
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Ensure RNAfold is in the path
    export PATH=/usr/local/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        dirmngr \
        wget \
        curl \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        build-essential \
        gfortran \
        cmake

    # 2. Install R (Current version)
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
    apt-get update && apt-get install -y r-base r-base-dev

    # 3. Install ViennaRNA (The engine for SS.features=TRUE)
    # We install from source or pre-compiled to ensure RNAfold is available
    apt-get install -y vienna-rna

    # 4. Install R Packages
    # Using a specific CRAN mirror for stability
    R -e "install.packages('seqinr', repos='https://cloud.r-project.org')"
    R -e "install.packages('e1071', repos='https://cloud.r-project.org')"
    R -e "install.packages('parallel', repos='https://cloud.r-project.org')"
    R -e "install.packages('LncFinder', repos='https://cloud.r-project.org')"

    # 5. Clean up to keep the image light
    apt-get clean && rm -rf /var/lib/apt/lists/*

%test
    # Verify R and LncFinder
    R -e "library(LncFinder); library(seqinr)"
    # Verify RNAfold (Critical for SS.features=TRUE)
    RNAfold --version
