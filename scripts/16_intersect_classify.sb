#!/bin/bash --login
#SBATCH --job-name=finalize
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=00:30:00
# NOTE: --output is NOT set here: submit_4_final_outputs.sh passes it (log dir from LOG_DIR in config.sh).

# Fix the locale warnings and suppress the systemd/timedatectl warning from R packages
export LC_ALL=C
export LANG=C
export TZ="UTC"
date

source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

# Species/sample prefix used for all file naming below

# R parsing image for output files
IMAGE="$RBIO_SIF"

# Single shared output directory for all intersect/classify steps (directory only, no prefix baked in)
INT_CLASS_OUT="$INT_CLASS_DIR"
mkdir -p $INT_CLASS_OUT

# File path prefix (directory + sample name) used throughout the rest of the script

# =======>------- Intersect IDs -------<======== #

# Input files. script can run with at least two of the tools, and works with gtf and txt files.
FEELnc="$FEELNC_GTF"
CPAT="$CPAT_OUT"
lncBoost="$LNCBOOST_PREDS"
lncFinder="$LNCFINDER_CSV"
DIAMOND="$DIAMOND_OUT"

echo -e ">>>Intersect:\nInput files:\n${FEELnc}\n${CPAT}\n${lncFinder}\n${lncBoost}\n${DIAMOND}\n...\n"

# Pass the flags directly to the image
cmd1="singularity run $IMAGE intersect -f $FEELnc -c $CPAT -l $lncFinder -b $lncBoost -d $DIAMOND -o $INT_PFX" # save run command in log file

echo -e ">>> Running intersect script...\n${cmd1}\n"
$cmd1

echo -e ">>>Intersect:\nIntersection complete.\nlncRNA IDs:\n${INT_PFX}_final_ids.txt\nTool summary:\n${INT_PFX}_intersection_summary.csv\n"

# =======>------- Pull seqs and gtf -------<======== #

CAN_SEQS="$CANDIDATES_FASTA"
CAN_GTF="$CANDIDATES_GTF"

echo -e ">>>Pulling sequences and gtf for final lncRNA IDs...\nInput files:\n${CAN_SEQS}\n${CAN_GTF}\n...\n"

ml purge
ml load SeqKit

# Pull the fasta sequences for the final lncRNA IDs
cmd2="seqkit grep -f ${INT_PFX}_final_ids.txt ${CAN_SEQS} > ${INT_PFX}_lncRNA.fasta"
echo -e ">>> Pulling sequences...\n${cmd2}\n"
seqkit grep -f ${INT_PFX}_final_ids.txt ${CAN_SEQS} > ${INT_PFX}_lncRNA.fasta

# Pull the gtf entries for the final lncRNA IDs
cmd3="grep -Fwf ${INT_PFX}_final_ids.txt ${CAN_GTF} > ${INT_PFX}_lncRNA.gtf"
echo -e ">>> Pulling GTF entries...\n${cmd3}\n"
grep -Fwf ${INT_PFX}_final_ids.txt ${CAN_GTF} > ${INT_PFX}_lncRNA.gtf

# =======>------- Classify lncRNAs (FEELnc_classifier.pl only) -------<======== #
# NOTE: the old separate "classify" step (classifications.R) is gone. Its
# per-category .txt files were never consumed by anything downstream - that
# logic now lives inside build_final_annotation.R as a single Category column.

FEELnc_IMG="$FEELNC_SIF"
FEELNC_DIR="$FEELNC_HOME"
LNC_GTF="${INT_PFX}_lncRNA.gtf"
mRNA_GTF="$REF_ANN"

cmd4="singularity exec \
  --env PERL5LIB="${FEELNC_DIR}/lib" \
  $FEELnc_IMG \
  perl ${FEELNC_DIR}/scripts/FEELnc_classifier.pl \
    -i $LNC_GTF \
    -a $mRNA_GTF \
    -w 10000 \
    -m 100000 \
    -v 1 > '${INT_PFX}_lncRNA_classes.txt'
"

echo -e ">>> Running FEELnc_classifier.pl...\n${cmd4}\n"

singularity exec \
  --env PERL5LIB="${FEELNC_DIR}/lib" \
  $FEELnc_IMG \
  perl ${FEELNC_DIR}/scripts/FEELnc_classifier.pl \
    -i $LNC_GTF \
    -a $mRNA_GTF \
    -w 10000 \
    -m 100000 \
    -v 1 > "${INT_PFX}_lncRNA_classes.txt"

echo -e ">>>Classification complete."

# =======>------- Intersect lncRNA/TE -------<======== #


echo -e ">>>Intersect lncRNA/TE:\nInput files:\n${LNC_GTF}\n${TE_GFF3}\n...\n"

cmd5="singularity run $IMAGE intersect_te -g $TE_GFF3 -t $LNC_GTF -o $INT_CLASS_OUT"

echo -e ">>> Running lncRNA/TE intersection script...\n${cmd5}\n"
$cmd5

echo -e ">>>Intersect lncRNA/TE:\nIntersection complete.\nSummary table:\n${INT_CLASS_OUT}/TE_lncRNA_intersect.txt\n"

# =======>------- Finalize annotation (classify + finalize + add_tissue, in one call) -------<======== #
# TRACKING_SUMMARY is produced by track_preds.sb, and TPM_SUMMARY is produced
# by build_tpm_matrix.sb - both run earlier in the pipeline (right after
# stringtie quantify & build tpm matrix) with no dependency on this script's outputs, so
# they're simply consumed here as inputs. build_final_annotation.R now does
# the Category labeling and the Tissue_Type/TPM joins itself via --tracking
# and --tpm, so the old separate "add_tissue" step and its temp file are gone.
# NOTE: TPM_SUMMARY assumes species_metadata.txt had a tissue/condition column
# (so build_tpm_matrix.sb wrote a .summary.tsv, not just a .matrix.tsv) - if
# yours doesn't, point TPM_SUMMARY at the .matrix.tsv instead.

TEMP_TSV="${INT_PFX}_tmp.tsv"
FINAL_TSV="$FINAL_ANNOTATION"

echo -e ">>>Finalize:\nBuilding final annotation table (with Category, Tissue_Type, and TPM)...\nInput dir:\n${INT_CLASS_OUT}\nTracking summary:\n${TRACKING_SUMMARY}\nTPM summary:\n${TPM_SUMMARY}\n...\n"

cmd6="singularity run $IMAGE finalize -d $INT_CLASS_OUT -o $TEMP_TSV -p $SPEC -t $TRACKING_SUMMARY --tpm $TPM_SUMMARY"

echo -e ">>> Running build_final_annotation.R...\n${cmd6}\n"
$cmd6

cmd7="(head -n 1 $TEMP_TSV; tail -n +2 $TEMP_TSV | sort -k1,1V -k2,2n) > ${FINAL_TSV}"

echo -e ">>> Sorting output based on chromosome and location\n${cmd7}\n"

(head -n 1 $TEMP_TSV; tail -n +2 $TEMP_TSV | sort -k1,1V -k2,2n) > ${FINAL_TSV}

echo -e ">>>Finalize:\nFinal annotation table complete:\n${FINAL_TSV}\n"

date
