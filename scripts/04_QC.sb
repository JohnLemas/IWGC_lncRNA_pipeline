#!/bin/bash --login
#SBATCH --job-name=QC
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=/path/to/project/dir/logs/%x-%j.SLURMout

# Load all required modules at the start
ml purge
ml load FastQC/0.12.1-Java-11
ml load MultiQC

BASE="/path/to/project/dir" # change this to reflect your working directory

# ==============================================================================
# 1. QC for Raw Reads
# ==============================================================================
IN_RAW="${BASE}/01_inputs/raw_reads"
OUT_RAW="${BASE}/01_inputs/raw_reads/QC"

mkdir -p "${OUT_RAW}"

echo -e ">>>Running QC on raw reads:\n$(ls -1 ${IN_RAW}/*.gz)"

# Run FastQC on all fastp gz files
fastqc -t 8 -o "${OUT_RAW}" "${IN_RAW}"/*.gz

# Run MultiQC on fastp QC outputs
multiqc "${OUT_RAW}" -n "raw_report" -o "${OUT_RAW}" --no-data-dir

echo ">>>Finished raw reads"

# ==============================================================================
# 2. QC for FastP Reads
# ==============================================================================
IN_FASTP="${BASE}/03_outputs/01_fastp"
OUT_FASTP="${BASE}/03_outputs/01_fastp/QC"

mkdir -p "${OUT_FASTP}/"

echo -e ">>>Running QC on trimmed reads:\n$(ls -1 ${IN_FASTP}/*.gz)"

# Run FastQC on all fastp gz files
fastqc -t 8 -o "${OUT_FASTP}" "${IN_FASTP}"/*.gz

# Run MultiQC on fastp QC outputs
multiqc "${OUT_FASTP}" -n "trimmed_report" -o "${OUT_FASTP}" --no-data-dir

echo ">>>Finished trimmed reads"
# ==============================================================================
# 3. QC for Clean (SortMeRNA) Reads
# ==============================================================================
IN_CLEAN="${BASE}/03_outputs/03_sortmerna/clean_reads"
OUT_CLEAN="${BASE}/03_outputs/03_sortmerna/QC"

mkdir -p "${OUT_CLEAN}/multiQC"

echo -e ">>> running QC on SortMeRNA-cleaned reads:\n$(ls -1 ${IN_CLEAN}/*.gz)"

# Run FastQC on clean gz files
fastqc -t 8 -o "${OUT_CLEAN}" "${IN_CLEAN}"/*.gz

# Run MultiQC on clean QC outputs
multiqc "${OUT_CLEAN}" -n 'clean_reads' -o "${OUT_CLEAN}" --no-data-dir

echo ">>> Quality check complete."