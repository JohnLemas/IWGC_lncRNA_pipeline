Bootstrap: docker
From: ubuntu:22.04

%files
    /mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/scripts/intersect_ids.R /usr/local/bin/intersect_ids.R
    /mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/scripts/classifications.R /usr/local/bin/classifications.R
    /mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/scripts/lncFinder.R /usr/local/bin/lncFinder.R

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        r-base \
        r-cran-tidyverse \
        r-cran-optparse \
        r-cran-readr \
        r-cran-dplyr \
        r-cran-seqinr \
        r-cran-e1071 \
        r-cran-caret \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Install LncFinder directly from CRAN
    Rscript -e "install.packages('LncFinder', repos='https://cloud.r-project.org')"

    # Ensure all pipeline scripts are in the system path and executable
    chmod +x /usr/local/bin/intersect_ids.R
    chmod +x /usr/local/bin/classifications.R
    chmod +x /usr/local/bin/lncFinder.R

%environment
    export LC_ALL=C

%runscript
    # The unified routing hub for your repository workflow
    if [ "$1" = "intersect" ]; then
        shift
        exec Rscript /usr/local/bin/intersect_ids.R "$@"
    elif [ "$1" = "classify" ]; then
        shift
        exec Rscript /usr/local/bin/classifications.R "$@"
    elif [ "$1" = "lnc_predict" ]; then
        shift
        exec Rscript /usr/local/bin/lncFinder.R "$@"
    else
        echo "=========================================================================="
        echo "Usage: singularity run rbio_tools.sif [tool_name] [options]"
        echo "=========================================================================="
        echo "Available tools:"
        echo "  intersect   - Runs intersect_ids.R"
        echo "  classify    - Runs classifications.R"
        echo "  lnc_predict - Runs lncFinder.R"
        echo "=========================================================================="
    fi

%labels
    Author "lemasjoh, Gemini"
    Version "2.0_Unified_R_Suites"
    Description "Combined R tools for lncRNA pipelines including ID routing, FEELnc parsing, and LncFinder ML modeling."