#!/bin/bash --login
#SBATCH --job-name=corn_stringtie
#SBATCH --array=1-165
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/stringtie_%A_%a.out

# 1. Paths
LIST="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/sra_accessions/z.mays_sra_IDs.txt"
ID=$(sed -n "${SLURM_ARRAY_TASK_ID}p" $LIST)
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/plant_lnc.sif"

# Input BAM directory
BAM_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/02_STAR"
REF_GTF="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.62.gtf"
OUT_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/03_stringtie"

mkdir -p $OUT_DIR

# 2. Run StringTie
# -G: Reference guided (finds known + novel)
# -p: Threads
# -m: Minimum transcript length (200bp is the standard cutoff for lncRNAs)
# -j: Minimum junction coverage (higher = fewer false positives)
# -o: Output GTF file
singularity exec $IMAGE stringtie \
    ${BAM_DIR}/${ID}_Aligned.sortedByCoord.out.bam \
    -G $REF_GTF \
    -p $SLURM_CPUS_PER_TASK \
    -m 200 \
    -j 2 \
    -o ${OUT_DIR}/${ID}_assembled.gtf

echo "StringTie assembly for $ID complete."