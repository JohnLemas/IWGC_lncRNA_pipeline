# ==============================================================================
# 1. ROOT DIRECTORIES TO COMPLETION BLOCK
# ==============================================================================
/corn/
/soy/
/uniprot_db/

# Block the specific loose root-level files you didn't want earlier
Fourier1_lncRNA.csv
Fourier2_lncRNA.csv
ORF_lncRNA.csv

# ==============================================================================
# 2. SPECIES DIRECTORY SURGERY (g.max & z.mays)
# ==============================================================================
# Allow Git into these folders, but ignore their general contents by default
!/g.max/
/g.max/*
!/z.mays/
/z.mays/*

# Whitelist the inputs directory and everything inside it
!/g.max/01_inputs/
!/g.max/01_inputs/**
!/z.mays/01_inputs/
!/z.mays/01_inputs/**

# Allow Git into the outputs directory, but keep it empty by default
!/g.max/03_outputs/
/g.max/03_outputs/*
!/z.mays/03_outputs/
/z.mays/03_outputs/*

# Whitelist ONLY your 3 specific output subdirectories
!/g.max/03_outputs/10_intersect/
!/g.max/03_outputs/10_intersect/**
!/g.max/03_outputs/11_classify/
!/g.max/03_outputs/11_classify/**
!/g.max/03_outputs/12_verify/
!/g.max/03_outputs/12_verify/**

!/z.mays/03_outputs/10_intersect/
!/z.mays/03_outputs/10_intersect/**
!/z.mays/03_outputs/11_classify/
!/z.mays/03_outputs/11_classify/**
!/z.mays/03_outputs/12_verify/
!/z.mays/03_outputs/12_verify/**

# ==============================================================================
# 3. GLOBAL LARGE FILE SAFETY NET (Blocks these formats everywhere)
# ==============================================================================
*fa
*fasta
*paf
*gtf
*gff3
*gff
*gz
*sif
.DS_Store
*gene_info.txt
.Rhistory