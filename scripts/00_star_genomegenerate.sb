#!/bin/bash --login
#SBATCH --job-name=species_star_idx
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=45G
#SBATCH --time=01:30:00
#SBATCH --output=/path/to/working/dir/species/logs/%x-%j.SLURMout

set -euo pipefail

# Paths
BASE="/path/to/working/dir" # change this to reflect your working directory
SPEC="species" # Set this to the species prefix for working directories and output files (ex: AmaTu=Amaranthus tuberculatus)
GENOME="${BASE}/${SPEC}/01_inputs/${SPEC}.chromosomes.fa" # make sure this matches the species prefix
ANNO="${BASE}/${SPEC}/01_inputs/${SPEC}_mRNA.gtf" # make sure this matches the species prefix
INDEX="${BASE}/${SPEC}/01_inputs/${SPEC}_indexed" # make sure this matches the species prefix

echo -e ">>>STAR:\n\tRunning build mode.\nInput fasta:\n\t${GENOME}\nInput annotation:\n\t${ANNO}"

echo -e "..making output directory:\n\t${INDEX}"
mkdir -p $INDEX

echo -e "...loading module.."
ml purge
ml load STAR/2.7.11b-GCC-13.2.0

STAR \
     --runMode genomeGenerate \
     --runThreadN $SLURM_CPUS_PER_TASK \
     --genomeDir $INDEX \
     --genomeFastaFiles $GENOME \
     --sjdbGTFfile $ANNO \
     --sjdbGTFtagExonParentTranscript Parent \
     --sjdbOverhang 99 \
     --genomeSAindexNbases 13

echo -e "..process complete. Indexed genome is in\n\t${INDEX}"