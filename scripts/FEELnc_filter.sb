#!/bin/bash --login
#SBATCH --job-name=feelnc_filter
#SBATCH --cpus-per-task=20
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/path/to/working/dir/logs/%x_%j.out

# 1. Paths
BASE="/path/to/working/dir" # change this to reflect your working directory
IMAGE="${BASE}/images/FEELnc2.sif"
INPUT_GTF="${BASE}/03_outputs/04_stringtie/species_candidates.gtf" # make sure this has your desired species prefix
REF_ANN="${BASE}/01_inputs/species_mRNA.gtf" # make sure this has your desired species prefix
OUTPUT_DIR="${BASE}/03_outputs/05_FEELnc"
OUTPUT_GTF="${BASE}/03_outputs/05_FEELnc/species_FEELnc.gtf" # make sure this has your desired species prefix
FEELNC_DIR="${BASE}/scripts/feelnc"

mkdir -p $OUTPUT_DIR

# 2. Run it
singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    env PERL5LIB="${FEELNC_DIR}/lib" \
    perl ${FEELNC_DIR}/scripts/FEELnc_filter.pl \
    -i $INPUT_GTF \
    -a $REF_ANN \
    --monoex=-1 -s 200 -p 20 > $OUTPUT_GTF

echo "FEELnc filtering complete."