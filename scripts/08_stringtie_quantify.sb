#!/bin/bash --login
#SBATCH --job-name=strg_quant
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
# NOTE: --array and --output are NOT set here: submit_2_stringtie.sh passes them (array size from METADATA, log dir from LOG_DIR in config.sh).

# ========>-------- Re-quantify each sample against the MERGED annotation to get TPM --------<======== #
# NOTE: This runs AFTER stringtie_merge.sb (needs species_denovo_trans.gtf) and is
# independent of track_preds.sb / intersect_classify.sb. It uses -e -B against the
# FULL merged GTF (known + novel), not the MSTRG-only candidates.gtf, so that reads
# from real mRNAs aren't forced onto lncRNA models and TPMs aren't inflated.
# transcript_id values are preserved from the merge step, so downstream matching to
# the lncRNA candidate list is a plain string match on transcript_id - no gffcompare
# tracking needed for this step.

# 1. Paths
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

# Extract row for current task and parse column 1 (raw ID) and column 2 (new name)
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$METADATA" | tr -d '\r')
ID=$(echo "$ROW" | awk -F'\t' '{print $2}')

BAM_DIR="$STAR_DIR"
OUT_DIR="${QUANT_DIR}/${ID}"

mkdir -p "$OUT_DIR"

ml purge
ml load StringTie/2.2.1-GCC-11.2.0-Python-2.7.18

# 2. Run StringTie in reference-only quantification mode
# -e: only estimate abundance for transcripts in -G (no novel assembly here)
# -B: write Ballgown-format tables (t_data.ctab has per-transcript TPM/FPKM/coverage)
# -G: the FULL merged GTF from stringtie_merge.sb (keeps read allocation honest)
cmd="stringtie \
    ${BAM_DIR}/${ID}_Aligned.sortedByCoord.out.bam \
    -e -B \
    -G $MERGED_GTF \
    -p $SLURM_CPUS_PER_TASK \
    -o ${OUT_DIR}/${ID}_quant.gtf"

echo -e "..running command:\n${cmd}\n\n"

$cmd

echo "StringTie TPM quantification for $ID complete: ${OUT_DIR}/t_data.ctab"
