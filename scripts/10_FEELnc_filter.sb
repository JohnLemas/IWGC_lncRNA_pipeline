#!/bin/bash --login
#SBATCH --job-name=feelnc_filter
#SBATCH --cpus-per-task=20
#SBATCH --mem=64G
#SBATCH --time=04:00:00
# NOTE: --output is NOT set here: submit_3_model_predictions.sh passes it (log dir from LOG_DIR in config.sh).

set -euo pipefail

# 1. Paths
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh
IMAGE="$FEELNC_SIF"

# Inputs
INPUT_GTF="$CANDIDATES_GTF"
OUTPUT_DIR="$FEELNC_OUT_DIR"
OUTPUT_GTF="$FEELNC_GTF"
FEELNC_DIR="$FEELNC_HOME"

mkdir -p $OUTPUT_DIR

# 2. Run the script with the image
singularity exec -B "$BIND_DIR" $IMAGE \
    env PERL5LIB="${FEELNC_DIR}/lib" \
    perl ${FEELNC_DIR}/scripts/FEELnc_filter.pl \
    -i $INPUT_GTF \
    -a $REF_ANN \
    --monoex=-1 -s 200 -p 20 > "${OUTPUT_GTF}.partial"

[ -s "${OUTPUT_GTF}.partial" ] || { echo "ERROR: FEELnc_filter produced an empty file" >&2; rm -f "${OUTPUT_GTF}.partial"; exit 1; }
mv "${OUTPUT_GTF}.partial" "$OUTPUT_GTF"

echo "FEELnc filtering complete."