#!/bin/bash --login
#SBATCH --job-name=species_track
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/path/to/working/dir/logs/%x_%j.out

# ========>------- Create tracking files -------<======== #
# NOTE: this step can run BEFORE intersect_classify.sb. It tracks tissue/sample
# support for every StringTie candidate transcript (not just the final filtered
# lncRNA set), so it has no dependency on the intersect/classify outputs and can
# run right after 05_stringtie. intersect_classify.sb consumes the resulting
# tracking summary TSV as an input to add the Tissue_Type column to its final table.

BASE="/path/to/working/dir"
PREFIX="species"

ASSEMBLY_DIR="${BASE}/03_outputs/05_stringtie/sample_assemblies"
OUT_DIR="${BASE}/03_outputs/10_trace"
REF="${BASE}/03_outputs/05_stringtie/${PREFIX}_candidates.gtf"
LIST="${OUT_DIR}/file_list.txt"
METADATA="${BASE}/01_inputs/${PREFIX}_metadata.txt"

mkdir -p $OUT_DIR

ls -d ${ASSEMBLY_DIR}/*_assembled.gtf > $LIST

ml purge
ml load Miniforge3

conda activate gffcompare

gffcompare -r $REF -i $LIST -o ${OUT_DIR}/candidate

# ========>------- Parse the output files -------<======== #

TRACK_FILE="${OUT_DIR}/candidate.tracking"
TRACKING_SUMMARY="${OUT_DIR}/${PREFIX}_tracking_summary.tsv"

CANDIDATE_FASTA="${BASE}/03_outputs/05_stringtie/${PREFIX}_candidates.fasta"

IMAGE="${BASE}/images/rbio_tools.sif"

cmd_track="singularity run $IMAGE track \
    -t \"$TRACK_FILE\" \
    -l \"$LIST\" \
    -f \"$CANDIDATE_FASTA\" \
    -m \"$METADATA\" \
    -o \"$TRACKING_SUMMARY\""

echo -e ">>> Running track_preds (parse_gffcompare_tracking.R)...\n${cmd_track}\n"

singularity run $IMAGE track \
    -t "$TRACK_FILE" \
    -l "$LIST" \
    -f "$CANDIDATE_FASTA" \
    -m "$METADATA" \
    -o "$TRACKING_SUMMARY"

echo -e ">>>Tissue tracking complete.\nSummary table for intersect_classify.sb:\n${TRACKING_SUMMARY}\n"
