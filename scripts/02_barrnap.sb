#!/bin/bash --login
#SBATCH --job-name=custom_db
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:30:00 # barrnap runs pretty quick
# NOTE: --output is NOT set here: submit_1_raw_to_alignment.sh passes it (log dir from LOG_DIR in config.sh).

set -euo pipefail

# ----------------------------------------------------------------------------
# USER-CONFIGURABLE SETTINGS
# ----------------------------------------------------------------------------

source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths below come from config.sh
SIF="$SMR_SIF"
# BARRNAP_GENOME (full NCBI assembly) comes from config.sh; GENOME is only used by the STAR/lncRNA steps

# This must be the SAME default SortMeRNA database file that sortmerna.sb points
# its DEFAULT variable at - the index built below is only valid for this exact
# pair of reference files, in this exact order.
DEFAULT_DB="$SMR_DEFAULT_DB"

KINGDOMS=(bac euk mito) # this runs all three models to capture nuclear, mitochondrial, and chloroplast rRNA genes

OUTDIR="$BARRNAP_DIR"
mkdir -p "${OUTDIR}"

THREADS=${SLURM_CPUS_PER_TASK:-8}
CDHIT_IDENTITY=0.97

COMBINED_FASTA="${OUTDIR}/combined_rrna.fasta"
CUSTOM_DB="$SMR_CUSTOM_DB"
INDEX_DIR="$SMR_IDX_DIR"

# ----------------------------------------------------------------------------
# STEP 1: Run barrnap on the genome, once per kingdom, via the image
# ----------------------------------------------------------------------------

name="${SPEC}"
GENOME_DIR=$(dirname "${BARRNAP_GENOME}")

echo "[$(date)] Running barrnap for kingdoms: ${KINGDOMS[*]} on ${BARRNAP_GENOME}"

# Some assemblies start with a long telomere repeat, (CCCTAAA)n, which contains no G.
# HMMER guesses the alphabet from the first ~4 kb of the file; with only A/C/T it cannot tell
# DNA from protein ("Unable to guess alphabet") and nhmmer aborts. Prepend a short, balanced
# dummy record so the guess succeeds. It cannot produce rRNA hits and does not shift any
# real contig's coordinates. The padded copy is deleted after barrnap finishes.
BARRNAP_INPUT="${OUTDIR}/${name}_barrnap_input.fa"
{
    echo ">alphabet_guess_pad"
    printf 'ACGT%.0s' $(seq 1 1200); echo
    zcat -f "${BARRNAP_GENOME}"   # works for plain or .gz fasta
} > "${BARRNAP_INPUT}"

KINGDOM_FASTAS=()

for kingdom in "${KINGDOMS[@]}"; do
    echo "  -> ${name} [${kingdom}]"
    
    out_fasta="${OUTDIR}/${name}_${kingdom}_rrna.fasta"
    KINGDOM_FASTAS+=("${out_fasta}")

    singularity exec -B "${GENOME_DIR}:${GENOME_DIR}" -B "${OUTDIR}:${OUTDIR}" "${SIF}" \
        barrnap \
            --kingdom "${kingdom}" \
            --threads "${THREADS}" \
            --outseq "${out_fasta}" \
            "${BARRNAP_INPUT}" \
        > "${OUTDIR}/${name}_${kingdom}_rrna.gff"
done

rm -f "${BARRNAP_INPUT}"

# ----------------------------------------------------------------------------
# STEP 2: Concatenate all per-kingdom rRNA FASTA outputs
# ----------------------------------------------------------------------------

echo "[$(date)] Concatenating per-kingdom rRNA FASTA files"
cat "${KINGDOM_FASTAS[@]}" > "${COMBINED_FASTA}"

n_seqs=$(grep -c '^>' "${COMBINED_FASTA}" || true)
echo "  Combined FASTA contains ${n_seqs} sequences"

if [ "${n_seqs}" -eq 0 ]; then
    echo "ERROR: no rRNA sequences were predicted. Check barrnap logs before proceeding." >&2
    exit 1
fi

# ----------------------------------------------------------------------------
# STEP 3: Dereplicate/cluster with cd-hit-est
# ----------------------------------------------------------------------------

echo "[$(date)] Loading cd-hit module"
ml purge
ml load CD-HIT

echo "[$(date)] Clustering combined FASTA at ${CDHIT_IDENTITY} identity"
cd-hit-est \
    -i "${COMBINED_FASTA}" \
    -o "${CUSTOM_DB}" \
    -c "${CDHIT_IDENTITY}" \
    -n 10 \
    -M $((16 * 1024)) \
    -T "${THREADS}" \
    -d 0

ml purge

# ----------------------------------------------------------------------------
# STEP 4: Build ONE shared index covering BOTH the default db and the custom
# db together, since that is how sortmerna.sb actually calls SortMeRNA
# (--ref DEFAULT --ref CUSTOM). An index built from CUSTOM_DB alone is not
# valid for that combined call - SortMeRNA hashes/validates the index against
# the exact set of --ref files (and their order) passed at runtime.
# ----------------------------------------------------------------------------

echo "[$(date)] Indexing default + custom rRNA databases together for SortMeRNA"
mkdir -p "${INDEX_DIR}"

if [ ! -f "${DEFAULT_DB}" ]; then
    echo "ERROR: DEFAULT_DB not found at ${DEFAULT_DB}. Set this to the same" >&2
    echo "       file sortmerna.sb's DEFAULT variable points to before indexing." >&2
    exit 1
fi

singularity exec -B "${OUTDIR}:${OUTDIR}" -B "$(dirname "${DEFAULT_DB}"):$(dirname "${DEFAULT_DB}")" "${SIF}" \
    sortmerna \
        --ref "${DEFAULT_DB}" \
        --ref "${CUSTOM_DB}" \
        --idx-dir "${INDEX_DIR}" \
        --index 1 \
        --task 5 \
        --threads "${THREADS}"

echo "[$(date)] Done. Shared index built for:"
echo "  Ref 1 (default): ${DEFAULT_DB}"
echo "  Ref 2 (custom):  ${CUSTOM_DB}"
echo "  Index directory: ${INDEX_DIR}"
echo ""
echo "In sortmerna.sb, point CUSTOM at this exact CUSTOM_DB path, set"
echo "SHARED_IDX_DIR to this exact INDEX_DIR path, and pass both"
echo "--idx-dir \"\$SHARED_IDX_DIR\" and --index 0 on every sortmerna call so it"
echo "reuses this index instead of rebuilding it per array task."