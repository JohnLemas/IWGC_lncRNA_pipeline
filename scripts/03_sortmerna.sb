#!/bin/bash --login
#SBATCH --job-name=species_sortmerna
#SBATCH --cpus-per-task=16
#SBATCH --mem=48G
#SBATCH --time=16:00:00
# NOTE: --array and --output are NOT set here: submit_1_raw_to_alignment.sh passes them (array size from METADATA, log dir from LOG_DIR in config.sh).

# NOTE: --array upper bound must equal the number of rows in the metadata file.
# Check with:  awk 'END{print NR}' A_tha_metadata.txt   (wc -l undercounts if the
# last line has no trailing newline).
#
# NOTE ON RESOURCES: mem/time here were sized to cover per-task indexing.
# Now that this script uses the shared index built by barrnap.sb (--idx-dir,
# --index 0 below), each task only aligns - it doesn't rebuild the index - so
# you can likely lower --mem and --time once you've confirmed a couple of
# tasks run cleanly under the new setup.

set -uo pipefail
# Not using -e globally: we want explicit exit-code checks around sortmerna
# itself rather than having the whole script die on an unrelated test failure.

# 1. Paths & Variables
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh
LIST="$METADATA"

# Column 1 = sequencing ID, column 2 = informative ID
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST" | tr -d '\r')
OLD_ID=$(echo "$ROW" | awk -F'\t' '{print $1}')
NEW_ID=$(echo "$ROW" | awk -F'\t' '{print $2}')

if [ -z "$ROW" ] || [ -z "$NEW_ID" ]; then
    echo "ERROR: no usable metadata row for array task ${SLURM_ARRAY_TASK_ID} in $LIST"
    echo "       (array range may exceed the number of rows, or the row has no column 2)"
    exit 1
fi

IN_DIR="$FASTP_DIR"
OUT_DIR="$SMR_DIR"
CLEAN_DIR="$SMR_CLEAN_DIR"
RRNA_DIR="$SMR_RRNA_DIR"
FAILED_DIR="$SMR_FAILED_DIR"

mkdir -p "$CLEAN_DIR" "$RRNA_DIR" "$FAILED_DIR"

# Container image - same one barrnap.sb uses, so indexing and alignment run
# against the identical SortMeRNA build/version.
SIF="$SMR_SIF"

# Database arguments (--ref db1.fasta --ref db2.fasta ...)
DEFAULT="$SMR_DEFAULT_DB"
CUSTOM="$SMR_CUSTOM_DB"

# Shared index built once by barrnap.sb (Step 4) covering BOTH DEFAULT and
# CUSTOM above, in that order. Must match barrnap.sb's INDEX_DIR exactly, and
# DEFAULT/CUSTOM above must match barrnap.sb's DEFAULT_DB/CUSTOM_DB exactly -
# SortMeRNA validates the index against the specific ref files/order given.
SHARED_IDX_DIR="$SMR_IDX_DIR"

# 2. Environment Setup
THREADS=${SLURM_CPUS_PER_TASK:-1}

echo "=========================================================="
echo "Processing Array Task: $SLURM_ARRAY_TASK_ID | Sample ID: $NEW_ID ($OLD_ID)"
echo "Start time: $(date)"
echo "=========================================================="

run_sortmerna_and_check () {
    # $1 = workdir, $2 = descriptive label for logging (pe/se)
    local WORKDIR="$1"
    local LABEL="$2"
    shift 2

    # --- Guard against stale/partial state from a previous failed attempt ---
    # A prior run that was OOM-killed or hit walltime can leave behind a
    # workdir with empty/partial index files. Always start from a clean directory.
    if [ -d "$WORKDIR" ]; then
        echo "WARNING: pre-existing workdir found at $WORKDIR - removing before this run to avoid stale/partial reuse."
        rm -rf "$WORKDIR"
    fi
    mkdir -p "$WORKDIR"

    echo "Running SortMeRNA ($LABEL) for $NEW_ID..."
    singularity exec -B "${BASE}:${BASE}" "${SIF}" \
        sortmerna "$@" --workdir "$WORKDIR" --threads "$THREADS"
    local EXIT_CODE=$?

    if [ $EXIT_CODE -ne 0 ]; then
        local FAIL_PATH="${FAILED_DIR}/${NEW_ID}_${LABEL}_$(date +%s)"
        echo "ERROR: sortmerna ($LABEL) exited with code $EXIT_CODE for $NEW_ID."
        echo "Preserving workdir for debugging at: ${FAIL_PATH}"
        mv "$WORKDIR" "$FAIL_PATH"
        return 1
    fi

    return 0
}

verify_log_complete () {
    # $1 = path to the .log file sortmerna writes next to --aligned prefix
    local LOGFILE="$1"
    if [ ! -f "$LOGFILE" ]; then
        echo "ERROR: expected log file not found: $LOGFILE"
        return 1
    fi
    if ! grep -q "Total reads passing E-value threshold" "$LOGFILE"; then
        echo "ERROR: log file $LOGFILE does not contain a completed summary block - run may have been truncated."
        return 1
    fi
    echo "Log verified complete: $LOGFILE"
    return 0
}

# 3. Detect sequencing mode from the fastp output names
#    fastp writes:  paired-end  -> ${NEW_ID}_1_trim.fastq.gz + ${NEW_ID}_2_trim.fastq.gz
#                   single-end  -> ${NEW_ID}_trim.fastq.gz   (no _1/_2)
PE_R1="${IN_DIR}/${NEW_ID}_1_trim.fastq.gz"
PE_R2="${IN_DIR}/${NEW_ID}_2_trim.fastq.gz"
SE_READS="${IN_DIR}/${NEW_ID}_trim.fastq.gz"

OVERALL_STATUS=0

if [ -f "$PE_R1" ] && [ -f "$PE_R2" ]; then

    # ---- Paired-end ----
    WORKDIR="${OUT_DIR}/workdir_pe_${NEW_ID}"

    if run_sortmerna_and_check "$WORKDIR" "pe" \
        --ref "${DEFAULT}" \
        --ref "${CUSTOM}" \
        --idx-dir "${SHARED_IDX_DIR}" \
        --index 0 \
        --reads "$PE_R1" \
        --reads "$PE_R2" \
        --aligned "${RRNA_DIR}/${NEW_ID}_pe_rRNA" \
        --other "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA" \
        --paired_in \
        --out2 \
        --fastx
    then
        if verify_log_complete "${RRNA_DIR}/${NEW_ID}_pe_rRNA.log"; then
            # Confirm the output files actually exist and are non-empty
            # before declaring success and deleting the workdir.
            if [ -s "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_fwd.fq.gz" ] && [ -s "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_rev.fq.gz" ]; then
                mv "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_fwd.fq.gz" "${CLEAN_DIR}/${NEW_ID}_1_sortmerna.fastq.gz"
                mv "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_rev.fq.gz" "${CLEAN_DIR}/${NEW_ID}_2_sortmerna.fastq.gz"
                echo "PE clean reads written for $NEW_ID."
                rm -rf "$WORKDIR"
            else
                echo "ERROR: expected clean-read output files missing or empty for $NEW_ID (PE). Preserving workdir."
                mv "$WORKDIR" "${FAILED_DIR}/${NEW_ID}_pe_missingoutput_$(date +%s)"
                OVERALL_STATUS=1
            fi
        else
            OVERALL_STATUS=1
        fi
    else
        OVERALL_STATUS=1
    fi

elif [ -f "$SE_READS" ]; then

    # ---- Single-end ----
    WORKDIR="${OUT_DIR}/workdir_se_${NEW_ID}"

    if run_sortmerna_and_check "$WORKDIR" "se" \
        --ref "${DEFAULT}" \
        --ref "${CUSTOM}" \
        --idx-dir "${SHARED_IDX_DIR}" \
        --index 0 \
        --reads "$SE_READS" \
        --aligned "${RRNA_DIR}/${NEW_ID}_se_rRNA" \
        --other "${CLEAN_DIR}/${NEW_ID}_se_non_rRNA" \
        --fastx
    then
        if verify_log_complete "${RRNA_DIR}/${NEW_ID}_se_rRNA.log"; then
            if [ -s "${CLEAN_DIR}/${NEW_ID}_se_non_rRNA.fq.gz" ]; then
                mv "${CLEAN_DIR}/${NEW_ID}_se_non_rRNA.fq.gz" "${CLEAN_DIR}/${NEW_ID}_singles_sortmerna.fastq.gz"
                echo "SE clean reads written for $NEW_ID."
                rm -rf "$WORKDIR"
            else
                echo "ERROR: expected clean-read output file missing or empty for $NEW_ID (SE). Preserving workdir."
                mv "$WORKDIR" "${FAILED_DIR}/${NEW_ID}_se_missingoutput_$(date +%s)"
                OVERALL_STATUS=1
            fi
        else
            OVERALL_STATUS=1
        fi
    else
        OVERALL_STATUS=1
    fi

elif [ -f "$PE_R1" ] || [ -f "$PE_R2" ]; then

    # Only one mate present - do NOT silently treat it as single-end.
    echo "ERROR: $NEW_ID has only one of ${NEW_ID}_1_trim / ${NEW_ID}_2_trim in ${IN_DIR} - incomplete pair."
    OVERALL_STATUS=1

else
    echo "ERROR: No matching FASTQ files found for $NEW_ID in ${IN_DIR}"
    echo "       Looked for: ${NEW_ID}_1_trim.fastq.gz + ${NEW_ID}_2_trim.fastq.gz (PE) or ${NEW_ID}_trim.fastq.gz (SE)"
    OVERALL_STATUS=1
fi

echo "=========================================================="
echo "Finished $NEW_ID with status $OVERALL_STATUS at $(date)"
echo "=========================================================="

# Propagate failure to SLURM so failed tasks show up in sacct / can be requeued.
exit $OVERALL_STATUS
