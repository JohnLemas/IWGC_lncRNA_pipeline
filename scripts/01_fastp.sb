#!/bin/bash --login
#SBATCH --job-name=fastp
#SBATCH --array=1-[number of samples from wc -l species_metadata.txt]
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/path/to/working/dir/species/logs/fastp/%x-%j_%a.SLURMout

set -euo pipefail

# 1. Paths & Variables
BASE="/path/to/working/dir" # change this to reflect your working directory
SPEC="species" # Set this to the species prefix for working directories and output files (ex: AmaTu=Amaranthus tuberculatus)

IN_DIR="${BASE}/${SPEC}/01_inputs/raw_fastq"
OUT_DIR="${BASE}/${SPEC}/03_outputs/01_fastp"
mkdir -p "$OUT_DIR"

# Pull the sequencing ID and swap it for the new ID
# make sure the column indices are correct- column 1 should be the sequencing ID and column 2 is the informative ID
METADATA="${BASE}/${SPEC}/01_inputs/${SPEC}_metadata.txt"
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$METADATA" | tr -d '\r')
OLD_ID=$(echo "$ROW" | awk -F'\t' '{print $1}')
NEW_ID=$(echo "$ROW" | awk -F'\t' '{print $2}')


# 2. Environment Setup
# There is no module for fastp, so use a conda environment
ml purge
ml load Miniforge3 # hpcc module for conda
conda activate fastp

echo "Processing Array Task: $SLURM_ARRAY_TASK_ID | Sample ID: $OLD_ID"

# --- SMART SEQUENCING MODE CHECK ---
# Case 1: True PAIRED-END (Both _1 and _2 files must exist)
if [ -f "${IN_DIR}/${OLD_ID}_1.fastq.gz" ] && [ -f "${IN_DIR}/${OLD_ID}_2.fastq.gz" ]; then
    echo "Processing $OLD_ID as TRUE PAIRED-END"
    fastp \
      -i "${IN_DIR}/${OLD_ID}_1.fastq.gz" \
      -I "${IN_DIR}/${OLD_ID}_2.fastq.gz" \
      -o "${OUT_DIR}/${NEW_ID}_1_trim.fastq.gz" \
      -O "${OUT_DIR}/${NEW_ID}_2_trim.fastq.gz" \
      --detect_adapter_for_pe \
      --thread 8 -x -g \
      --html "${OUT_DIR}/${NEW_ID}_fastp.html" \
      --json "${OUT_DIR}/${NEW_ID}_fastp.json"

# Case 2: SINGLE-END but named with a '_1.fastq.gz' suffix
elif [ -f "${IN_DIR}/${OLD_ID}_1.fastq.gz" ]; then
    echo "Processing $OLD_ID as SINGLE-END (Input file: ${OLD_ID}_1.fastq.gz)"
    fastp \
      -i "${IN_DIR}/${OLD_ID}_1.fastq.gz" \
      -o "${OUT_DIR}/${NEW_ID}_trim.fastq.gz" \
      --thread 8 -x -g \
      --html "${OUT_DIR}/${NEW_ID}_fastp.html" \
      --json "${OUT_DIR}/${NEW_ID}_fastp.json"

# Case 3: SINGLE-END named traditionally '.fastq.gz'
elif [ -f "${IN_DIR}/${OLD_ID}.fastq.gz" ]; then
    echo "Processing $OLD_ID as SINGLE-END (Input file: ${OLD_ID}.fastq.gz)"
    fastp \
      -i "${IN_DIR}/${OLD_ID}.fastq.gz" \
      -o "${OUT_DIR}/${NEW_ID}_trim.fastq.gz" \
      --thread 8 -x -g \
      --html "${OUT_DIR}/${NEW_ID}_fastp.html" \
      --json "${OUT_DIR}/${NEW_ID}_fastp.json"

# Error Catching: File not found
else
    echo "ERROR: Could not find raw fastq data for $OLD_ID in $IN_DIR"
    exit 1
fi