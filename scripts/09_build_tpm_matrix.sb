#!/bin/bash --login
#SBATCH --job-name=species_tpm
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
# NOTE: --output is NOT set here: submit_2_stringtie.sh passes it (log dir from LOG_DIR in config.sh).

# ========>------- Build the lncRNA TPM matrix -------<======== #
# NOTE: Run this AFTER stringtie_quantify.sb has produced t_data.ctab for every
# sample. Like track_preds.sb, this has no dependency on intersect_classify.sb -
# it only needs species_candidates.gtf (to know which transcript_ids to keep) and
# can run in parallel with the tissue-tracking step. intersect_classify.sb (or
# build_final_annotation.R) should join the resulting *.summary.tsv onto the final
# table on transcript_id, the same way it already joins in the tracking summary.

source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh
IMAGE="$RBIO_SIF"

OUT_DIR="$STRINGTIE_DIR"
OUT_PREFIX="$TPM_PREFIX"

mkdir -p "$OUT_DIR"

cmd_tpm="singularity run $IMAGE tpm \
    -q \"$QUANT_DIR\" \
    -c \"$CANDIDATES_GTF\" \
    -m \"$METADATA\" \
    -o \"$OUT_PREFIX\""

echo -e ">>> Running build_tpm_matrix (parse_tpm_matrix.R)...\n${cmd_tpm}\n"

singularity run $IMAGE tpm \
    -q "$QUANT_DIR" \
    -c "$CANDIDATES_GTF" \
    -m "$METADATA" \
    -o "$OUT_PREFIX"

echo -e ">>> TPM matrix complete.\nPer-sample matrix: ${OUT_PREFIX}.matrix.tsv\nPer-tissue summary (if metadata has a tissue column): ${OUT_PREFIX}.summary.tsv\n"
