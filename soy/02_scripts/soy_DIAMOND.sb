#!/bin/bash --login
#SBATCH --job-name=soy_DIAMOND
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x_%j.out

# load module
ml purge
ml load DIAMOND/2.1.8-GCC-12.3.0

# Load input files
echo -e ">>>DIAMOND:\n...loading input files and database.."
INPUT="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/04_gffread/soy_candidates.fasta"
OUTDIR="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/09_diamond"
OUTPUT="${OUTDIR}/soy_diamond_out.txt"
DB="/mnt/scratch/lemasjoh/BASF/uniprot_db/uniprot_out.dmnd"

echo -e ">>>DIAMOND:\nDatabase:\n\t${DB}\nInput sequences:\n\t${INPUT}"

echo -e "...create output directory:\n${OUTDIR}"
mkdir -p $OUTDIR

cmd1="diamond blastx --threads $SLURM_CPUS_PER_TASK -d $DB -q $INPUT -o $OUTPUT --outfmt 6 --sensitive --max-target-seqs 1 --evalue 1e-5"
echo -e ">>>DIAMOND: run command:\n${cmd1}"

$cmd1

echo -e "..done. Output file:\n\t${OUTPUT}\nProcess complete."