#!/bin/bash --login
#SBATCH --job-name=species_track
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=00:30:00
# NOTE: --output is NOT set here: submit_2_stringtie.sh passes it (log dir from LOG_DIR in config.sh).

set -euo pipefail

# ========>------- Create tracking files -------<======== #
# NOTE: this step can run BEFORE intersect_classify.sb. It tracks tissue/sample
# support for every StringTie candidate transcript (not just the final filtered
# lncRNA set), so it has no dependency on the intersect/classify outputs and can
# run right after 04_stringtie. intersect_classify.sb consumes the resulting
# tracking summary TSV as an input to add the Tissue_Type column to its final table.

source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh

OUT_DIR="$TRACE_DIR"
REF="$CANDIDATES_GTF"
LIST="$TRACE_LIST"

mkdir -p $OUT_DIR

ls -d ${ASSEMBLY_DIR}/*_assembled.gtf > $LIST

ml purge
ml load Miniforge3

conda activate gffcompare

gffcompare -r $REF -i $LIST -o ${OUT_DIR}/candidate

# ========>------- Parse the output files -------<======== #

TRACK_FILE="${OUT_DIR}/candidate.tracking"

CANDIDATE_FASTA="$CANDIDATES_FASTA"

IMAGE="$RBIO_SIF"

cmd_track="singularity run $IMAGE track \
    -t \"$TRACK_FILE\" \
    -l \"$LIST\" \
    -f \"$CANDIDATE_FASTA\" \
    -m \"$METADATA\" \
    -o \"$TRACKING_SUMMARY\""

echo -e ">>> Running track_preds (parse_gffcompare_tracking.R)...\n${cmd_track}\n"

singularity run $IMAGE track \
    -t "$TRACK_FILE" \
    -l "$LIST" \
    -f "$CANDIDATE_FASTA" \
    -m "$METADATA" \
    -o "$TRACKING_SUMMARY"

echo -e ">>>Tissue tracking complete.\nSummary table for intersect_classify.sb:\n${TRACKING_SUMMARY}\n"
