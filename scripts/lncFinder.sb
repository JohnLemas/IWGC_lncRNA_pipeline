#!/bin/bash --login
#SBATCH --job-name=species_lncFinder
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=1-00:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x_%j.out

# Paths
IMAGE="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/def_files/rbio_tools_v2.sif"
RSCRIPT="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/scripts/lncFinder.R"
OUTPUT_DIR="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/species/03_outputs/08_lncFinder"
INPUT_FASTA="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/species/03_outputs/04_gffread/species_candidates.fasta"
OUTPUT_CSV="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/species/03_outputs/08_lncFinder/species_lncFinder_results.csv"

mkdir -p $OUTPUT_DIR

echo "=========================================================="
echo "Parsing and LncFinder Matrix Processing"
echo "=========================================================="
date

# Run the unified R script inside the container
singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    Rscript $RSCRIPT \
    -i "$INPUT_FASTA" \
    -o "$OUTPUT_CSV" \
    -p $SLURM_CPUS_PER_TASK

echo "=========================================================="
echo "PIPELINE FINISHED SUCCESSFULLY"
echo "=========================================================="
date