#!/bin/bash --login
#SBATCH --job-name=species_RNAfold
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=12:00:00 # based on the 132k candidates in the Z. mays run after the filtering step
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x_%j.out

# Paths
IMAGE="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/def_files/viennarna.sif"

INPUT_FASTA="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/species/03_outputs/04_gffread/species_candidates.fasta"
OUTPUT_DIR="/mnt/scratch/lemasjoh/BASF/IWGC_lncRNA_pipeline/species/03_outputs/08_lncFinder"
STRUCT_TXT="$OUTPUT_DIR/folded_structures.tmp"
STRUCT_FIN="$OUTPUT_DIR/folded_structures.txt"

mkdir -p $OUTPUT_DIR

echo "=========================================================="
echo "Filtering candidates for secondary structure algorithm (200-100,000 nt)"
echo "=========================================================="

ml purge
ml load SeqKit

# Filter the candidates to only those that are between 200 and 100,000 nt in length (lncRNA length range)
seqkit seq -m 200 -M 100000 $INPUT_FASTA > "$OUTPUT_DIR/filtered_candidates.fasta"

echo "=========================================================="
echo "Native Stream RNA Folding via RNAfold image"
echo "=========================================================="
date

singularity exec -B /mnt/scratch/lemasjoh $IMAGE \
    RNAfold --noPS --jobs=$SLURM_CPUS_PER_TASK < "$OUTPUT_DIR/filtered_candidates.fasta" > "$STRUCT_TXT"

date

echo "=========================================================="
echo "Cleaning output for lncFinder"
echo "=========================================================="

# Clean raw output file

grep -v -E "\[WARNING\]|Skipping" "$STRUCT_TXT" > "$STRUCT_FIN"

# Remove temporary file
rm "$STRUCT_TXT"

echo "=========================================================="
echo -e "Done. SS file ready for lncFinder:\t$(basename $STRUCT_FIN)"
echo "=========================================================="