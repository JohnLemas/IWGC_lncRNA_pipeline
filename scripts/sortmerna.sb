#!/bin/bash --login
#SBATCH --job-name=sortmerna
#SBATCH --array=1-[number of samples from wc -l species_sra_IDs.txt]
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --output=/path/to/working/dir/logs/sortmerna/%x-%a.SLURMout

# 1. Paths & Variables
BASE="/path/to/working/dir"
LIST="${BASE}/01_inputs/species_metadata.txt"

ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST" | tr -d '\r')
OLD_ID=$(echo "$ROW" | awk '{print $1}')
NEW_ID=$

# Path to your container image (UPDATE THIS PATH TO YOUR SIF FILE)
IMG="${BASE}/images/sortmerna.sif"

IN_DIR="${BASE}/03_outputs/02_fastp"
OUT_DIR="${BASE}/03_outputs/03_sortmerna"
CLEAN_DIR="${OUT_DIR}/clean_reads"
RRNA_DIR="${OUT_DIR}/rRNA_reads"

mkdir -p "$CLEAN_DIR" "$RRNA_DIR"

# Path to unpacked database directory / fasta files (UPDATE THIS PATH)
DB_DIR="${BASE}/01_inputs/databases"
# Database arguments (--ref db1.fasta --ref db2.fasta ...)
DEFAULT="${BASE}/01_inputs/databases/smr_v4.3_default_db.fasta"
CUSTOM="${BASE}/01_inputs/databases/species_rDNA.fasta"

# 2. Environment Setup

THREADS=${SLURM_CPUS_PER_TASK:-1}

echo "Processing Array Task: $SLURM_ARRAY_TASK_ID | Sample ID: $NEW_ID ($OLD_ID)"

# 3. Process Paired-End Reads
if [ -f "${IN_DIR}/${NEW_ID}_1_trim.fastq.gz" ] && [ -f "${IN_DIR}/${NEW_ID}_2_trim.fastq.gz" ]; then
    echo "Running SortMeRNA on PAIRED-END reads for $NEW_ID..."
    
    WORKDIR="${OUT_DIR}/workdir_pe_${NEW_ID}"
    mkdir -p "$WORKDIR"

    singularity exec \
      --bind "${BASE}:${BASE}" \
      "$IMG" sortmerna \
        --ref ${DEFAULT} \
        --ref ${CUSTOM} \
        --reads "${IN_DIR}/${NEW_ID}_1_trim.fastq.gz" \
        --reads "${IN_DIR}/${NEW_ID}_2_trim.fastq.gz" \
        --workdir "$WORKDIR" \
        --aligned "${RRNA_DIR}/${NEW_ID}_pe_rRNA" \
        --other "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA" \
        --paired_in \
        --out2 \
        --fastx \
        --threads "$THREADS"

    # Rename outputs to standard STAR-friendly fastq.gz names
    mv "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_fwd.fq.gz" "${CLEAN_DIR}/${NEW_ID}_1_sortmerna.fastq.gz"
    mv "${CLEAN_DIR}/${NEW_ID}_pe_non_rRNA_rev.fq.gz" "${CLEAN_DIR}/${NEW_ID}_2_sortmerna.fastq.gz"

    # Clean up heavy temporary index/workdir files
    rm -rf "$WORKDIR"
fi

# 4. Process Single-End Reads
if [ -f "${IN_DIR}/${NEW_ID}_singles_trim.fastq.gz" ]; then
    echo "Running SortMeRNA on SINGLE-END reads for $NEW_ID..."

    WORKDIR="${OUT_DIR}/workdir_se_${NEW_ID}"
    mkdir -p "$WORKDIR"

    singularity exec \
      --bind "${BASE}:${BASE}" \
      "$IMG" sortmerna \
        --ref ${DEFAULT} \
        --ref ${CUSTOM} \
        --reads "${IN_DIR}/${NEW_ID}_singles_trim.fastq.gz" \
        --workdir "$WORKDIR" \
        --aligned "${RRNA_DIR}/${NEW_ID}_se_rRNA" \
        --other "${CLEAN_DIR}/${NEW_ID}_se_non_rRNA" \
        --fastx \
        --threads "$THREADS"

    # Rename single output to standard fastq.gz
    mv "${CLEAN_DIR}/${NEW_ID}_se_non_rRNA.fq.gz" "${CLEAN_DIR}/${NEW_ID}_singles_sortmerna.fastq.gz"

    # Clean up heavy temporary index/workdir files
    rm -rf "$WORKDIR"
fi

echo "SortMeRNA filtering completed for $NEW_ID."