#!/bin/bash --login
#SBATCH --job-name=corn_merge
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x-%j.out

# 1. Paths
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/plant_lnc.sif"
ID_FILE="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/sra_accessions/z.mays_sra_IDs.txt"
GTF_DIR="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/03_stringtie"
REF_GTF="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/01_input/genome/Zea_mays.Zm-B73-REFERENCE-NAM-5.0.62.gtf"
OUT_GTF="/mnt/scratch/lemasjoh/BASF/RNA_central/corn/03_output/03_stringtie/corn_denovo_trans.gtf"

# Load the file IDs into a Bash array
mapfile -t SRA_IDS < "$ID_FILE"

# Create the list of GTF file paths
gtf_filePath=()
for ID in "${SRA_IDS[@]}"; do
    # Only add the file if it actually exists (to prevent StringTie from crashing)
    FILE_PATH="${GTF_DIR}/${ID}_assembled.gtf"
    if [ -f "$FILE_PATH" ]; then
        gtf_filePath+=("$FILE_PATH")
    else
        echo "Warning: $FILE_PATH not found, skipping."
    fi
done

# 2. Run the Merge
# --merge: Tells StringTie to combine the list
# -G: Your original reference (keeps known gene names)
# -o: The final master file
# -m: Minimum transcript length to include in the master (200bp)
singularity exec $IMAGE stringtie --merge -G $REF_GTF -m 200 -o $OUT_GTF ${gtf_filePath[*]}

echo "Master Merge Complete: $OUT_GTF"