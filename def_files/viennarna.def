Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer lemasjoh
    Version v2.7.2_Source
    Description Ultra-optimized image containing ViennaRNA compiled from source for high-speed folding

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/usr/local/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install system dependencies, building prerequisites, and pkg-config
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        build-essential \
        gfortran \
        libgomp1 \
        pkg-config \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # 2. Download and Compile ViennaRNA from official Source 
    cd /tmp
    wget https://www.tbi.univie.ac.at/RNA/download/sourcecode/2_7_x/ViennaRNA-2.7.2.tar.gz
    tar -zxvf ViennaRNA-2.7.2.tar.gz
    cd ViennaRNA-2.7.2
    
    # Configure with OpenMP optimization for multi-threading, omitting unused language wrappers
    ./configure --without-perl --without-python --without-python3 --disable-all-bind
    make -j$(nproc)
    make install
    
    # Clean up the build files to keep the image compact
    cd /tmp
    rm -rf ViennaRNA-2.7.2*

%runscript
    # Allows you to use 'singularity run' to drop arguments straight into RNAfold
    exec RNAfold "$@"

%test
    # Verify RNAfold executable is natively available and functioning
    RNAfold --version