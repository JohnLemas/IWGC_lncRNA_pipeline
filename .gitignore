# 1. Ignore absolutely everything by default at the root
*
# But don't ignore the gitignore file itself
!.gitignore

# 2. Allow Git to look inside the species directories
!/g.max/
!/z.mays/

# 3. Ignore everything inside the species folders by default
# (This catches README.md, md5sum.txt, ncbi_dataset, .zip files, etc.)
/g.max/*
/z.mays/*

# 4. Whitelist the inputs directory and its contents
!/g.max/01_inputs/
!/g.max/01_inputs/**
!/z.mays/01_inputs/
!/z.mays/01_inputs/**

# 5. Allow Git to look into outputs, but keep it empty by default
!/g.max/03_outputs/
/g.max/03_outputs/*
!/z.mays/03_outputs/
/z.mays/03_outputs/*

# 6. Whitelist ONLY your specific output subdirectories
!/g.max/03_outputs/10_intersect/
!/g.max/03_outputs/10_intersect/**
!/g.max/03_outputs/11_classify/
!/g.max/03_outputs/11_classify/**
!/g.max/03_outputs/12_verify/
!/g.max/03_outputs/12_verify/**

!/z.mays/03_outputs/10_intersect/
!/z.mays/03_outputs/10_intersect/**
!/z.mays/03_outputs/11_classify/
!/z.mays/03_outputs/11_classify/**
!/z.mays/03_outputs/12_verify/
!/z.mays/03_outputs/12_verify/**

# 7. Global large file safety net (just in case they are inside whitelisted folders)
*fa
*fasta
*paf
*fai
*gtf
*gff3
*gff
*gz
*sif
.DS_Store
*gene_info.txt
.Rhistory
g.max_indexed/
z.mays_indexed/