#!/bin/bash --login
#SBATCH --job-name=soy_intersect
#SBATCH --cpus-per-task=4
#SBATCH --mem=64
#SBATCH --time=1:00:00
#SBATCH --output=/mnt/scratch/lemasjoh/BASF/logs/%x_%j.out

# Fix the locale warnings
export LC_ALL=C
export LANG=C

# Input files
FEELnc="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/05_FEELnc/soy_FEELnc.gtf"
CPAT="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/06_cpat/soy_cpat.output"
lncBoost="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/07_lncBoost/soy_predictions.txt"
lncFinder="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/08_lncFinder/soy_lncFinder_wheat_model_results.csv"
DIAMOND="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/09_diamond/soy_diamond_out.txt"

echo -e ">>>Final intersect:\nInput files:\n${FEELnc}\n${CPAT}\n${lncFinder}\n${lncBoost}\n${DIAMOND}\n...\n"

# Output files
OUTDIR="/mnt/scratch/lemasjoh/BASF/RNA_central/soy/03_output/10_final"
OUTPFX="${OUTDIR}/soy_"

echo -e ">>>Final intersect:\nMaking output directory:\n${OUTDIR}\n...\n"

mkdir -p $OUTDIR

# Image
IMAGE="/mnt/scratch/lemasjoh/BASF/scripts/intersect_ids.sif"

# Just pass the flags directly to the image
cmd="singularity run $IMAGE -f $FEELnc -c $CPAT -l $lncFinder -b $lncBoost -d $DIAMOND -o $OUTPFX"

echo -e ">>> Running via Singularity Image...\n${cmd}\n"
$cmd

echo -e ">>>Final intersect:\nIntersection complete.\nlncRNA IDs:\n${OUTPFX}_final_ids.txt\nTool summary:\n${OUTPFX}_intersection_summary.csv\n"