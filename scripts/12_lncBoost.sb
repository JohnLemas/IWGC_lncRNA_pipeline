#!/bin/bash --login
#SBATCH --job-name=lncBoost
#SBATCH --cpus-per-task=20
#SBATCH --mem=64G
#SBATCH --time=02:00:00
# NOTE: --output is NOT set here: submit_3_model_predictions.sh passes it (log dir from LOG_DIR in config.sh).

set -euo pipefail
date

# --- Paths ---
source "${CONFIG:-${SLURM_SUBMIT_DIR:-.}/config.sh}"   # all paths come from config.sh
IMAGE="$LNCBOOST_SIF"

SCRIPT_DIR="$LNCBOOST_SCRIPT_DIR"   # contains Feature_extraction.py and PlantLncBoost_prediction.py
MODEL="$LNCBOOST_MODEL"

INPUT_FASTA="$CANDIDATES_FASTA"
OUT_DIR="$LNCBOOST_DIR"
FEATURE_CSV="$LNCBOOST_FEATURES"
FINAL_RESULTS="$LNCBOOST_PREDS"

mkdir -p ${OUT_DIR}

# --- STEP 1: Feature Extraction ---
echo "Starting Feature Extraction..."
singularity exec -B "$BIND_DIR" $IMAGE \
    python3 ${SCRIPT_DIR}/Feature_extraction.py -i $INPUT_FASTA -o $FEATURE_CSV

# --- STEP 2: Prediction ---
echo "...feature extraction complete.\nStarting Prediction..."
singularity exec -B "$BIND_DIR" $IMAGE \
    python3 ${SCRIPT_DIR}/PlantLncBoost_prediction.py \
    -i $FEATURE_CSV \
    -m $MODEL \
    -o $FINAL_RESULTS \
    -t 0.5

echo "Pipeline complete. Results are in $FINAL_RESULTS"

date