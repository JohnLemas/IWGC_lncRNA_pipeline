#!/bin/bash --login
#SBATCH --job-name=species_align
#SBATCH --array=1-[number of samples from wc -l species_metadata.txt]
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:00:00 # sortmeRNA applies a heavy filter. Check remaining read dept and adjust accordingly
#SBATCH --output=/path/to/working/dir/species/logs/align/%x-%j_%A.out

# 1. Paths & Variables
BASE="/path/to/working/dir"
SPEC="species"

# Extract row for current task and parse column 1 (raw ID) and column 2 (new name)
# Make sure the metadata is built so that the read ID from the machine is column 1 and the new ID with tissue type info is column 2. 
METADATA="${BASE}/${SPEC}/01_inputs/${SPEC}_metadata.txt"
ROW=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$METADATA" | tr -d '\r')
OLD_ID=$(echo "$ROW" | awk -F'\t' '{print $1}')
NEW_ID=$(echo "$ROW" | awk -F'\t' '{print $2}')

# Input reads come directly from SortMeRNA clean_reads directory
DATA_DIR="${BASE}/${SPEC}/03_outputs/02_sortmerna/clean_reads"
INDEX_DIR="${BASE}/${SPEC}/01_inputs/${SPEC}_indexed"
OUT_DIR="${BASE}/${SPEC}/03_outputs/03_STAR"
TMP_DIR="${OUT_DIR}/tmp_${NEW_ID}"

# Intron limits written by 00_star_genomegenerate.sb
INTRON_FILE="${BASE}/${SPEC}/01_inputs/${SPEC}_intron_limits.txt"
[ -s "$INTRON_FILE" ] || { echo "ERROR: missing $INTRON_FILE" >&2; exit 1; }

INTRON_LIMIT=$(awk -F= '$1=="INTRON_LIMIT"{print $2}' "$INTRON_FILE")
if ! [[ "$INTRON_LIMIT" =~ ^[0-9]+$ ]] || [ "$INTRON_LIMIT" -lt 1000 ]; then
    echo "ERROR: bad INTRON_LIMIT '${INTRON_LIMIT}' in $INTRON_FILE" >&2; exit 1
fi
echo "Using intron limit: $INTRON_LIMIT"

mkdir -p "$OUT_DIR" "$TMP_DIR"

THREADS=${SLURM_CPUS_PER_TASK:-1}

# 2. Environment Setup
ml purge
ml load STAR
ml load SAMtools

echo "Processing Array Task: $SLURM_ARRAY_TASK_ID | Sample ID: $NEW_ID ($OLD_ID)"

STAR_OPTS=(
  --runThreadN "$THREADS"
  --genomeDir "$INDEX_DIR"
  --readFilesCommand zcat
  --outSAMtype BAM SortedByCoordinate
  --outSAMattrIHstart 0
  --outSAMattributes NH HI AS nM NM
  --outSAMstrandField intronMotif
  --outFilterType BySJout
  --alignIntronMin 20
  --alignIntronMax "$INTRON_LIMIT"
  --alignMatesGapMax "$INTRON_LIMIT"
  --outFilterMultimapNmax 10
)

# --- 3. PAIRED-END ---
if [ -f "${DATA_DIR}/${NEW_ID}_1_sortmerna.fastq.gz" ] && [ -f "${DATA_DIR}/${NEW_ID}_2_sortmerna.fastq.gz" ]; then
    echo "Aligning Paired-End non-rRNA reads for $NEW_ID..."
    STAR "${STAR_OPTS[@]}" \
      --readFilesIn "${DATA_DIR}/${NEW_ID}_1_sortmerna.fastq.gz" "${DATA_DIR}/${NEW_ID}_2_sortmerna.fastq.gz" \
      --outFileNamePrefix "${TMP_DIR}/pe_" \
      || { echo "ERROR: STAR PE failed for $NEW_ID" >&2; exit 1; }
fi

# --- 4. SINGLE-END ---
if [ -f "${DATA_DIR}/${NEW_ID}_singles_sortmerna.fastq.gz" ]; then
    echo "Aligning Single-End non-rRNA reads for $NEW_ID..."
    STAR "${STAR_OPTS[@]}" \
      --readFilesIn "${DATA_DIR}/${NEW_ID}_singles_sortmerna.fastq.gz" \
      --outFileNamePrefix "${TMP_DIR}/se_" \
      || { echo "ERROR: STAR SE failed for $NEW_ID" >&2; exit 1; }
fi

# --- 5. MERGE BAMS FOR DOWNSTREAM ncRNA ANALYSIS ---
PE_BAM="${TMP_DIR}/pe_Aligned.sortedByCoord.out.bam"
SE_BAM="${TMP_DIR}/se_Aligned.sortedByCoord.out.bam"
FINAL_BAM="${OUT_DIR}/${NEW_ID}_Aligned.sortedByCoord.out.bam"

if [ -f "$PE_BAM" ] && [ -f "$SE_BAM" ]; then
    echo "Merging PE and SE BAM files into $FINAL_BAM..."
    samtools merge -@ "$THREADS" -o "$FINAL_BAM" "$PE_BAM" "$SE_BAM"
    samtools index -@ "$THREADS" "$FINAL_BAM"
elif [ -f "$PE_BAM" ]; then
    echo "Moving PE BAM to final destination..."
    mv "$PE_BAM" "$FINAL_BAM"
    samtools index -@ "$THREADS" "$FINAL_BAM"
elif [ -f "$SE_BAM" ]; then
    echo "Moving SE BAM to final destination..."
    mv "$SE_BAM" "$FINAL_BAM"
    samtools index -@ "$THREADS" "$FINAL_BAM"
else
    echo "ERROR: No BAM files generated for $NEW_ID in $TMP_DIR"
    exit 1
fi

# Move and rename STAR final log files with sample ID
for f in "${TMP_DIR}"/*_Log.final.out "${TMP_DIR}"/*_Log.out "${TMP_DIR}"/*_SJ.out.tab; do
    [ -f "$f" ] || continue
    b=$(basename "$f")                 # e.g. pe_Log.final.out
    mv "$f" "${OUT_DIR}/${NEW_ID}_${b}"
done

# Clean up temp directory
rm -rf "$TMP_DIR"

echo "STAR Alignment for $NEW_ID complete."
